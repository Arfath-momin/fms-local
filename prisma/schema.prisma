// FMS schema — simplified 3-module model (Purchase / Expense / Sale).
// The app is a ledger: totals are entered, the bill image carries the detail,
// and each party (boat, seller, buyer, expense vendor) gets an auto-built
// running ledger. No inventory/stock accounting — Profit = Sale − (Purchase +
// Expense).
//
// All primary keys are UUIDs generated client-side (Prisma @default(uuid())
// runs in the client, not the database) — kept for future offline support.
// Never switch these to autoincrement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  MERCHANT // full access
  AUDITOR // read-only, no entry screens
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ---------- Core ----------

model Company {
  id        String   @id @default(uuid())
  name      String   @unique // "BFM" / "B2B"
  createdAt DateTime @default(now()) @map("created_at")

  centres       Centre[]
  purchases     Purchase[]
  deliveryNotes DeliveryNote[]
  sales         Sale[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  attachments   Attachment[]
  dayCloses     DayClose[]

  @@map("companies")
}

// A centre is a fully isolated ledger/transaction scope inside a company
// (added via Masters). Every transaction and ledger entry is stamped with both
// company_id and centre_id; balances are derived per (company, centre, party).
// P/L is deliberately NOT computed per centre — the merchant splits purchase
// and sale across centres, so P/L aggregates at the company (and union) level.
model Centre {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id])
  purchases     Purchase[]
  deliveryNotes DeliveryNote[]
  sales         Sale[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  attachments   Attachment[]
  dayCloses     DayClose[]

  @@unique([companyId, name])
  @@map("centres")
}

// Every ledger is keyed to a Party. Boat/seller names are typed on the
// purchase and resolved to a Party (find-or-create by name+type); buyers and
// expense vendors work the same way. Global, NOT company-scoped — shared
// across BFM and B2B. Balances are never stored here; they are derived from
// LedgerEntry per company.
enum PartyType {
  BOAT // Society / KFDC / Private purchases are tracked per boat
  LOCAL_SELLER // "Name" on a Local purchase
  MARKET_BUYER
  FACTORY
  FISH_MILL
  LOCAL_BUYER
  EXPENSE_VENDOR // ice plant, landlord, loaders group, etc.
  CARE_OF // commission agent who pays immediately; a Fish Mill/Factory sale
  // "via CareOf" keeps the real buyer on the sale record but posts the ledger
  // to this CareOf party instead.
}

model Party {
  id          String    @id @default(uuid())
  name        String
  type        PartyType
  contactInfo String?   @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")

  purchases     Purchase[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  salesAsBuyer  Sale[]        @relation("SaleBuyer")
  salesAsCareOf Sale[]        @relation("SaleCareOf")

  @@unique([name, type])
  @@map("parties")
}

// ---------- Purchases ----------

enum PurchaseType {
  SOCIETY
  KFDC
  PRIVATE
  LOCAL
}

// Society / KFDC / Private: party is the boat, amount is the grand total, and
// the fish breakdown lives in the attached bill image. Local: party is the
// seller ("Name"), amount is the sum of its line items.
model Purchase {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  centreId  String       @map("centre_id")
  partyId   String       @map("party_id")
  type      PurchaseType
  amount    Decimal      @db.Decimal(14, 2)
  paid      Boolean      @default(true) // false → stays outstanding in the party ledger
  date      DateTime     @db.Date
  createdAt DateTime     @default(now()) @map("created_at")

  company Company        @relation(fields: [companyId], references: [id])
  centre  Centre         @relation(fields: [centreId], references: [id])
  party   Party          @relation(fields: [partyId], references: [id])
  lines   PurchaseLine[]

  @@index([companyId, centreId, date])
  @@map("purchases")
}

// Itemised rows for a LOCAL purchase only (spec: Name · Particular · Quantity
// · Price/kg · Total). Society/KFDC/Private purchases have no lines.
model PurchaseLine {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  particular String
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_lines")
}

// ---------- Expenses ----------

enum ExpenseCategory {
  ICE
  LOADERS
  LADIES
  BATHA
  CANTEEN
  RENT
}

// One row per expense. `details` holds the per-category fields (ICE: vehicle,
// plant, blocks, rate; Loaders/Ladies: boxes, rate; Rent: vehicle; etc.);
// `amount` is always the total that flows to the ledger and the Profit report.
model Expense {
  id        String          @id @default(uuid())
  companyId String          @map("company_id")
  centreId  String          @map("centre_id")
  partyId   String          @map("party_id") // expense vendor / category ledger
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(14, 2)
  paid      Boolean         @default(true)
  details   Json?
  notes     String?
  date      DateTime        @db.Date
  createdAt DateTime        @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  @@index([companyId, centreId, category, date])
  @@map("expenses")
}

// ---------- Delivery Notes (record only) ----------

// A delivery note is a pure dispatch record — no ledger, no settlement, no
// money movement. Header fields + line items + an optional bill image. Column
// totals (box / big box / loose / pcs) are summed on the fly for display; the
// note itself carries no accounting.
model DeliveryNote {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  centreId    String   @map("centre_id")
  billNo      String   @map("bill_no")
  date        DateTime @db.Date
  recipient   String // the "To" field
  vehicleNo   String   @map("vehicle_no")
  advancePaid Decimal? @map("advance_paid") @db.Decimal(14, 2)
  driverName  String?  @map("driver_name")
  mobileNo    String?  @map("mobile_no")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company            @relation(fields: [companyId], references: [id])
  centre  Centre             @relation(fields: [centreId], references: [id])
  lines   DeliveryNoteLine[]

  @@index([companyId, centreId, date])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String  @id @default(uuid())
  deliveryNoteId String  @map("delivery_note_id")
  particulars    String
  kg             Decimal @default(0) @db.Decimal(12, 3)
  box            Int     @default(0)
  bigBox         Int     @default(0) @map("big_box")
  loose          Int     @default(0)
  pcs            Int     @default(0)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------- Sales ----------

enum SaleType {
  MARKET
  FISH_MILL
  FACTORY
  LOCAL
}

// A sale posts to the buyer party's ledger — or, when routed "via CareOf"
// (Fish Mill / Factory), to the CareOf party instead, while the real buyer
// stays on the record. `amount` is the figure recognised as sale revenue and
// posted to the ledger (Market → Net Bill; Fish Mill → table total rate;
// Factory → bill amount total; Local → table total). `amountReceived` is what
// has been collected; the shortfall stays outstanding in that ledger.
// Type-specific header fields all live here; only the relevant ones are set.
model Sale {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  centreId      String   @map("centre_id")
  type          SaleType
  partyId       String   @map("party_id") // the buyer
  careOfPartyId String?  @map("care_of_party_id") // ledger posts here when set
  billNo        String   @map("bill_no")
  date          DateTime @db.Date

  amount         Decimal @db.Decimal(14, 2)
  amountReceived Decimal @default(0) @map("amount_received") @db.Decimal(14, 2)

  // Market-only (recorded/displayed, not posted):
  totalBill  Decimal? @map("total_bill") @db.Decimal(14, 2) // gross incl. seller profit + expenses
  commission Decimal? @db.Decimal(14, 2) // 2% of totalBill, reference only
  place      String? // Market "Place"

  // Fish Mill-only:
  weight         Decimal? @db.Decimal(12, 3)
  netWeight      Decimal? @map("net_weight") @db.Decimal(12, 3)
  vehicleNo      String?  @map("vehicle_no")
  placeOfLoading String?  @map("place_of_loading")

  // Factory-only:
  returnNote String? @map("return_note")

  createdAt DateTime @default(now()) @map("created_at")

  company     Company    @relation(fields: [companyId], references: [id])
  centre      Centre     @relation(fields: [centreId], references: [id])
  party       Party      @relation("SaleBuyer", fields: [partyId], references: [id])
  careOfParty Party?     @relation("SaleCareOf", fields: [careOfPartyId], references: [id])
  lines       SaleLine[]

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, type])
  @@map("sales")
}

// Line items for Fish Mill and Local sales.
// Fish Mill: box · variety(particular) · kgs(qtyKg) · rate/kg · count · total.
// Local:     particular · qty(qtyKg) · rate/kg · total.
model SaleLine {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  particular String
  box        Int? // Fish Mill only
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  ratePerKg  Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  count      Int? // Fish Mill only
  total      Decimal @db.Decimal(14, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_lines")
}

// ---------- Ledger ----------

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  PURCHASE
  SALE
  EXPENSE
  PAYMENT
}

// One generic ledger table powers every party statement — no per-party-type
// ledger tables. Sign convention: positive = party owes us, negative = we owe
// the party. DEBIT increases the balance, CREDIT decreases it.
model LedgerEntry {
  id             String           @id @default(uuid())
  companyId      String           @map("company_id")
  centreId       String           @map("centre_id")
  partyId        String           @map("party_id")
  type           LedgerEntryType
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String           @map("source_id")
  amount         Decimal          @db.Decimal(14, 2)
  date           DateTime         @db.Date
  runningBalance Decimal          @map("running_balance") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  @@index([companyId, centreId, partyId, date])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

// ---------- Attachments ----------

enum AttachmentLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

model Attachment {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  centreId   String               @map("centre_id")
  linkedType AttachmentLinkedType @map("linked_type")
  linkedId   String               @map("linked_id")
  imageUrl   String               @map("image_url")
  uploadedAt DateTime             @default(now()) @map("uploaded_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@index([linkedType, linkedId])
  @@map("attachments")
}

// ---------- Day close & corrections ----------

// A date with a DayClose row is locked — no direct edits via normal UI.
// Trigger model: explicit "Close Day" merchant action.
model DayClose {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  centreId  String   @map("centre_id")
  date      DateTime @db.Date
  closedAt  DateTime @default(now()) @map("closed_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@unique([companyId, centreId, date])
  @@map("day_closes")
}

enum ErrorFlagLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

// Closed-day corrections: the original row is never deleted; it gets an
// ErrorFlag and a replacement record linked via correctingEntryId. Reports
// exclude flagged records from totals but keep them visible in audit views.
model ErrorFlag {
  id                String              @id @default(uuid())
  linkedType        ErrorFlagLinkedType @map("linked_type")
  linkedId          String              @map("linked_id")
  flaggedAt         DateTime            @default(now()) @map("flagged_at")
  reason            String?
  correctingEntryId String?             @map("correcting_entry_id")

  @@unique([linkedType, linkedId])
  @@map("error_flags")
}
