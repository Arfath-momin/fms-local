// FMS schema — simplified 3-module model (Purchase / Expense / Sale).
// The app is a ledger: totals are entered, the bill image carries the detail,
// and each party (boat, seller, buyer, expense vendor) gets an auto-built
// running ledger. No inventory/stock accounting — Profit = Sale − (Purchase +
// Expense).
//
// All primary keys are UUIDs generated client-side (Prisma @default(uuid())
// runs in the client, not the database) — kept for future offline support.
// Never switch these to autoincrement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  SUPER_ADMIN // everything ADMIN can do, plus the irreversible operations the
  // merchant is deliberately kept away from: unarchiving a master, and really
  // deleting one. Never grantable from inside the app — see
  // scripts/create-user.ts — so a merchant admin cannot promote themselves.
  ADMIN // full access; the only role that may edit an existing voucher
  ACCOUNTANT // may enter vouchers and manage parties, but never edit a voucher
  AUDITOR // read-only; no voucher menu, drill-down from ledgers only
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  // Accounts are deactivated, never deleted — vouchers reference their author
  // and that history has to survive someone leaving.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  purchasesCreated     Purchase[]      @relation("PurchaseCreatedBy")
  purchasesUpdated     Purchase[]      @relation("PurchaseUpdatedBy")
  expensesCreated      Expense[]       @relation("ExpenseCreatedBy")
  expensesUpdated      Expense[]       @relation("ExpenseUpdatedBy")
  salesCreated         Sale[]          @relation("SaleCreatedBy")
  salesUpdated         Sale[]          @relation("SaleUpdatedBy")
  deliveryNotesCreated DeliveryNote[]  @relation("DeliveryNoteCreatedBy")
  deliveryNotesUpdated DeliveryNote[]  @relation("DeliveryNoteUpdatedBy")
  settlementsCreated   Settlement[]    @relation("SettlementCreatedBy")
  settlementsUpdated   Settlement[]    @relation("SettlementUpdatedBy")
  reviewsRequested     ReviewRequest[] @relation("ReviewRequestedBy")
  reviewsResolved      ReviewRequest[] @relation("ReviewResolvedBy")
  companies            UserCompany[]

  @@map("users")
}

/// Which companies an account may work in.
///
/// BFM and B2B share this installation but are separate businesses with
/// separate partners, so an admin of one has no business reading the other's
/// ledgers. A grant is the whole of that permission: the company switcher shows
/// only what the user holds, and getActiveCompany() refuses a cookie naming a
/// company they do not — which is what makes this an actual boundary rather
/// than a hidden menu.
///
/// SUPER_ADMIN needs no rows here and is never filtered; the system owner sees
/// every company by definition.
model UserCompany {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@map("user_companies")
}

// ---------- Core ----------

model Company {
  id        String   @id @default(uuid())
  name      String   @unique // "BFM" / "B2B"
  /// The colour of this company's band and switcher chip, as `#rrggbb`.
  ///
  /// Company identity is the app's first design rule — you must never be in
  /// doubt whose books are on screen. That used to be two hardcoded CSS rules
  /// keyed on the names BFM and B2B, which meant a third company rendered in
  /// the default blue and looked exactly like BFM. Storing it makes the colour
  /// a property of the company rather than of the stylesheet.
  ///
  /// Null falls back to the stylesheet, which is what rows created before this
  /// column do.
  colour    String?  @db.VarChar(7)

  // --- Letterhead ---------------------------------------------------------
  // Printed at the top of every sale bill and delivery note. All optional: a
  // company with none of it still prints, just with the short name alone, so
  // adding a company never blocks on paperwork details nobody has to hand yet.

  /// The registered name, when it differs from the short one used in the UI —
  /// "Bismillah Fish Merchants" against a switcher that reads "BFM". Printed
  /// in place of `name` on documents when set.
  legalName     String? @map("legal_name")
  /// Free-form, newlines preserved — Indian addresses do not fit a fixed shape.
  address       String?
  phone         String?
  email         String?
  /// Who to ask for. Printed on the bill so a buyer with a query has a name.
  contactPerson String? @map("contact_person")
  /// GST identification number, printed on documents where quoted.
  gstin         String?
  /// Storage key of the logo in the same image store as bill photos (see
  /// src/lib/attachments.ts). A key rather than a foreign key to Attachment:
  /// that model requires a centreId, and a company logo belongs to no centre.
  logoKey       String? @map("logo_key")

  createdAt DateTime @default(now()) @map("created_at")

  centres        Centre[]
  users          UserCompany[]
  purchases      Purchase[]
  deliveryNotes  DeliveryNote[]
  sales          Sale[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  attachments    Attachment[]
  settlements    Settlement[]
  reviewRequests ReviewRequest[]
  vehicles       Vehicle[]
  documentSeries DocumentSeries[]
  expenseCategories ExpenseCategory[]
  reserveCollections ReserveCollection[]

  @@map("companies")
}

// A centre is a fully isolated ledger/transaction scope inside a company
// (added via Masters). Every transaction and ledger entry is stamped with both
// company_id and centre_id; balances are derived per (company, centre, party).
// P/L is deliberately NOT computed per centre — the merchant splits purchase
// and sale across centres, so P/L aggregates at the company (and union) level.
model Centre {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  /// Set when the centre is retired. Every transaction below still points here
  /// and every ledger, register and report reads exactly as before — an
  /// archived centre simply stops being offered in the switcher and the entry
  /// screens, so nothing new can land in it. Deletion is reserved for centres
  /// that were never used at all.
  archivedAt DateTime? @map("archived_at")

  company        Company         @relation(fields: [companyId], references: [id])
  purchases      Purchase[]
  deliveryNotes  DeliveryNote[]
  sales          Sale[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  attachments    Attachment[]
  settlements    Settlement[]
  reviewRequests ReviewRequest[]
  reserveCollections ReserveCollection[]

  @@unique([companyId, name])
  @@map("centres")
}

// Every ledger is keyed to a Party. Boat/seller names are typed on the
// purchase and resolved to a Party (find-or-create by name+type); buyers and
// expense vendors work the same way. Global, NOT company-scoped — shared
// across BFM and B2B. Balances are never stored here; they are derived from
// LedgerEntry per company.
enum PartyType {
  BOAT // the vessel named on each line of a Society / KFDC purchase. A name
  // registry only — nothing ever posts a LedgerEntry against it, because the
  // money is owed to the society that sent the boat, not to the boat.
  MARKET_BUYER
  FACTORY
  FISH_MILL
  LOCAL_BUYER
  EXPENSE_VENDOR // ice plant, landlord, loaders group, etc.
  CARE_OF // an agent who pays immediately; a Fish Mill/Factory sale "via
  // CareOf" keeps the real buyer on the sale record but posts the ledger to
  // this CareOf party instead.
  PURCHASE_GROUP // whoever a purchase is owed to. Society and KFDC are one
  // standing account each, fixed by the purchase type, however many boats they
  // send; a Private or Local purchase names its own seller, who gets a ledger
  // of their own so payments settle against the right person. The individual
  // boat is recorded on the line, never as a ledger. See src/lib/party.ts
  // (FIXED_PURCHASE_PARTY).
  TRANSPORTER // owns the vehicles. Rent for a trip is credited here and
  // settled by the advance and by whatever a market party paid the driver on
  // BFM's behalf; a balance that does not close at zero means something is
  // genuinely unpaid, and that signal must not be suppressed (spec §2).
}

// LOCAL_SELLER, COMMISSION and RESERVE were removed here (spec §3.7).
//
// LOCAL_SELLER was already retired — a Local purchase names its seller as a
// PURCHASE_GROUP with a ledger of their own.
//
// COMMISSION and RESERVE were a misreading of the business. BFM is a fish
// merchant, not a commission agent: commission is a cost the market charges
// BFM and is netted inside the bill, never credited to a BFM account, and
// reserve is withheld by the market with a balance derived PER MARKET PARTY,
// never pooled into one standing account. Removing the enum values makes
// recreating either of those accounts a compile error rather than a decision
// somebody could quietly make again.

model Party {
  id          String    @id @default(uuid())
  name        String
  type        PartyType
  contactInfo String?   @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Set when the party is retired. It vanishes from the pickers and the master
  /// list but keeps every voucher and ledger entry it ever had, which is why
  /// this is a timestamp and not a delete. Note the (name, type) unique below
  /// still applies to archived rows: typing the name again resolves to this
  /// party and revives it, rather than starting a second ledger from zero.
  archivedAt  DateTime? @map("archived_at")
  /// Which kind of purchase this party sells through — PURCHASE_GROUP only.
  ///
  /// Society, KFDC and every private and local seller share one party type,
  /// because they share one thing that matters to the ledger: the money is owed
  /// to them. But that made the purchase form suggest all of them at once, so
  /// entering a Private bill offered KFDC and every local seller too. This
  /// narrows the suggestions without splitting the type the ledger is keyed on.
  ///
  /// Null on every other party type, and on a purchase party that predates the
  /// backfill or was created by hand from Masters.
  purchaseKind PurchaseType? @map("purchase_kind")

  purchases           Purchase[]
  purchaseLinesAsBoat PurchaseLine[] @relation("PurchaseLineBoat")
  expenses            Expense[]
  ledgerEntries       LedgerEntry[]
  salesAsBuyer        Sale[]         @relation("SaleBuyer")
  salesAsCareOf       Sale[]         @relation("SaleCareOf")
  settlements         Settlement[]
  vehicles            Vehicle[]      @relation("VehicleTransporter")
  reserveCollections  ReserveCollection[]

  @@unique([name, type])
  @@map("parties")
}

/// A truck, and who owns it.
///
/// Vehicles were free text on the delivery note, which meant "KA-20-B-5521",
/// "KA20B5521" and "ka 20 b 5521" were three different trucks and none of them
/// pointed at a transporter to owe rent to. A master fixes both: the number is
/// stored normalised so a lookup can never miss on formatting, and every trip
/// reaches its transporter's ledger through this row.
model Vehicle {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  /// Stored normalised (uppercase, no spaces or dashes) so lookups can never
  /// miss on formatting; display formatting is a UI concern.
  number        String
  transporterId String    @map("transporter_id")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company     Company        @relation(fields: [companyId], references: [id])
  transporter Party          @relation("VehicleTransporter", fields: [transporterId], references: [id])
  trips       DeliveryNote[]

  @@unique([companyId, number])
  @@index([transporterId])
  @@map("vehicles")
}

// ---------- Purchases ----------

enum PurchaseType {
  SOCIETY
  KFDC
  PRIVATE
  LOCAL
}

// Every purchase is itemised, and `amount` is always the sum of its lines —
// never typed in. Society / KFDC name the boat on each line (one bill can cover
// several vessels); Private / Local name the seller once, in `partyId`, because
// that is who the money is owed to.
model Purchase {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  centreId    String       @map("centre_id")
  /// The ledger this purchase settles against: Society, KFDC, or — for a
  /// Private or Local purchase — the named individual seller. NOT the boat.
  partyId     String       @map("party_id")
  /// The "No." on a Society/KFDC bill, the "Invoice No." on a Private/Local
  /// one — the same field under two names on paper. Deliberately not unique:
  /// real bill books repeat numbers across centres and across years.
  billNo      String?      @map("bill_no")
  type        PurchaseType
  amount      Decimal      @db.Decimal(14, 2)
  date        DateTime     @db.Date
  /// Free-form remark carried by every voucher type. Never read by a ledger,
  /// a balance or a report — it is what the entering clerk wanted the next
  /// person to know, and it prints on the document.
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  // Null updatedAt means "never edited" — that is why this is not @updatedAt,
  // which would also fire on insert.
  updatedAt   DateTime?    @map("updated_at")
  createdById String?      @map("created_by_id")
  updatedById String?      @map("updated_by_id")

  company   Company        @relation(fields: [companyId], references: [id])
  centre    Centre         @relation(fields: [centreId], references: [id])
  party     Party          @relation(fields: [partyId], references: [id])
  createdBy User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?          @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  lines     PurchaseLine[]

  @@index([companyId, centreId, date])
  @@map("purchases")
}

// One row of a purchase bill.
//
//   Society / KFDC   Boat · Particulars · Total Kg · Rate/kg · Amount
//   Private / Local  Particular · Qty · Rate · Amount
//
// `boatId` is therefore set on Society/KFDC lines and null on Private/Local
// ones, where the seller is the purchase's party rather than a per-line detail.
// Like the old header boat it is a name registry only: nothing posts a
// LedgerEntry against a vessel, because the money is owed to the party that
// sent it.
model PurchaseLine {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  boatId     String? @map("boat_id")
  particular String
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  boat     Party?   @relation("PurchaseLineBoat", fields: [boatId], references: [id])

  @@index([purchaseId])
  @@index([boatId])
  @@map("purchase_lines")
}

// ---------- Expenses ----------

/// Which profit tier an expense belongs to.
///
/// This is the whole reason categories became data. A salary is not a cost of
/// Tuesday's catch, and charging it against Tuesday's gross profit makes the
/// daily figure meaningless. DIRECT costs belong to a buying day; OVERHEAD
/// costs belong to a month and touch net profit only (spec §2).
enum ExpenseKind {
  DIRECT // ice, loaders, ladies, batha, canteen, vehicle rent
  OVERHEAD // salaries, office rent, electricity
}

/// Expense categories as rows, not as an enum.
///
/// They were an enum, which meant adding "electricity" was a migration and a
/// deploy, and — worse — gave nowhere to record whether a category is a direct
/// cost of a catch or a monthly overhead. Both problems are the same problem:
/// a category is data the merchant owns, not a fact about the code.
model ExpenseCategory {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  code        String // ICE, LOADERS, LADIES, BATHA, CANTEEN, RENT, SALARY, ...
  name        String
  kind        ExpenseKind
  /// True for OTHER and similar: the voucher shows a description/amount line
  /// table that sums into `amount`, instead of one flat figure.
  allowsLines Boolean     @default(false) @map("allows_lines")
  sortOrder   Int         @default(0) @map("sort_order")
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@unique([companyId, code])
  @@map("expense_categories")
}

/// One line of an itemised expense, for categories with `allowsLines`.
///
/// "Other ₹4,300" tells nobody anything a month later. The lines sum into
/// Expense.amount, which stays the single figure every report reads — so the
/// detail is additive, and no report has to know whether a voucher was
/// itemised.
model ExpenseLine {
  id          String  @id @default(uuid())
  expenseId   String  @map("expense_id")
  description String
  amount      Decimal @db.Decimal(14, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_lines")
}

// One row per expense. `details` holds the per-category fields (ICE: vehicle,
// plant, blocks, rate; Loaders/Ladies: boxes, rate; Rent: vehicle; etc.);
// `amount` is always the total that flows to the ledger and the Profit report.
model Expense {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  centreId    String          @map("centre_id")
  /// OPTIONAL. A canteen bill or a salary line has no vendor worth a ledger,
  /// and forcing one only fills the party master with junk nobody settles
  /// against. Set it when the money is genuinely owed to someone.
  partyId     String?         @map("party_id")
  categoryId  String          @map("category_id")
  /// The trip this cost came off, for a vehicle-rent expense (spec §4: a sale
  /// or expense links to its trip by deliveryNoteId, NEVER by matching date and
  /// vehicle text). It used to live in `details` as `{ tripId }`, which is the
  /// same mistake one layer down — a JSON blob no foreign key protects and no
  /// query can join through, so the rent ledger could not name the vehicle the
  /// rent was for. Null on every expense that is not tied to a trip.
  deliveryNoteId String?      @map("delivery_note_id")
  amount      Decimal         @db.Decimal(14, 2)
  details     Json?
  notes       String?
  /// THE ACCOUNTING DATE — the buying day this cost belongs to. Ice bought on
  /// the 17th for the 16th's catch is dated the 16th, so it lands in that
  /// day's profit alongside the purchase it was spent on. Read by the ledger,
  /// the Day Book and every report.
  date        DateTime        @db.Date
  /// When the money actually went out. Record only, read by nothing that
  /// computes a figure — the counterpart to Sale.saleDate. Null on rows from
  /// before the two dates were separated.
  spentOn     DateTime?       @map("spent_on") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime?       @map("updated_at")
  createdById String?         @map("created_by_id")
  updatedById String?         @map("updated_by_id")

  company      Company       @relation(fields: [companyId], references: [id])
  centre       Centre        @relation(fields: [centreId], references: [id])
  party        Party?          @relation(fields: [partyId], references: [id])
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  deliveryNote DeliveryNote?   @relation(fields: [deliveryNoteId], references: [id])
  createdBy    User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  lines        ExpenseLine[]

  @@index([companyId, centreId, categoryId, date])
  @@index([companyId, centreId, date])
  @@index([deliveryNoteId])
  @@map("expenses")
}

// ---------- Delivery Notes (record only) ----------

// A delivery note is a pure dispatch record — no ledger, no settlement, no
// money movement. Header fields + line items + an optional bill image. Column
// totals (box / big box / loose / pcs) are summed on the fly for display; the
// note itself carries no accounting.
/// Which channel a trip was dispatched to. Replaces the old free-text
/// recipient as the thing the system reasons about: rent settles differently
/// per channel, and only MARKET carries deductions.
enum TripChannel {
  MARKET
  FACTORY
  FISH_MILL
  LOCAL
}

/// How far along a trip is. Bills come back 2–3 days later, so a trip is
/// normally open for a while and "what is still out" is a question worth
/// answering every morning.
enum TripStatus {
  DISPATCHED // out, no bills yet
  PART_BILLED // some bills in
  CLOSED // all bills in, reconciled
}

/// A trip: one truck, one buying day, one channel.
///
/// Still called DeliveryNote, and still `delivery_notes`, deliberately —
/// renaming would churn every route under vouchers/deliveries and
/// (print)/vouchers/deliveries for no gain (rebuild plan, ground rule 5).
/// What changed is what it MEANS: it used to be a despatch slip addressed to a
/// recipient, and it is now the thing bills point back at.
model DeliveryNote {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  centreId    String    @map("centre_id")
  billNo      String    @map("bill_no")

  /// THE BUYING DAY this load came from. One trip, one buying day — a load is
  /// never split across buying days, which is what lets a bill arriving three
  /// days later still be accounted to the day the fish was bought.
  date         DateTime  @db.Date
  /// When the truck actually left. Record only — read by nothing that computes
  /// a figure.
  dispatchedOn DateTime? @map("dispatched_on") @db.Date

  channel   TripChannel
  vehicleId String      @map("vehicle_id")

  /// Total rent agreed for this trip. Expensed ONCE, on `date`, as a direct
  /// expense — never as a separate rent voucher. The advance and whatever a
  /// market party paid the driver are settlements against this, not further
  /// expenses.
  rentAmount  Decimal? @map("rent_amount") @db.Decimal(14, 2)
  /// Paid to the driver before departure. MARKET only; null on other channels,
  /// where BFM pays the driver in full on his return.
  advancePaid Decimal? @map("advance_paid") @db.Decimal(14, 2)

  status TripStatus @default(DISPATCHED)
  /// Empty crates that came back. Closes the box loop.
  cratesReturned Int? @map("crates_returned")

  /// Free text, retained for the printed note. No longer load-bearing — who
  /// received what comes from the bills that point back at this trip.
  recipient  String?
  driverName String? @map("driver_name")
  mobileNo   String? @map("mobile_no")
  /// Free-form remark — see the note on Purchase.notes.
  notes      String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company   Company            @relation(fields: [companyId], references: [id])
  centre    Centre             @relation(fields: [centreId], references: [id])
  vehicle   Vehicle            @relation(fields: [vehicleId], references: [id])
  createdBy User?              @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("DeliveryNoteUpdatedBy", fields: [updatedById], references: [id])
  lines     DeliveryNoteLine[]
  sales     Sale[]
  expenses  Expense[]

  @@index([companyId, centreId, date])
  @@index([status])
  @@index([vehicleId])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String  @id @default(uuid())
  deliveryNoteId String  @map("delivery_note_id")
  particulars    String
  kg             Decimal @default(0) @db.Decimal(12, 3)
  box            Int     @default(0)
  bigBox         Int     @default(0) @map("big_box")
  loose          Int     @default(0)
  pcs            Int     @default(0)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------- Sales ----------

enum SaleType {
  MARKET
  FISH_MILL
  FACTORY
  LOCAL
}

// A sale posts to the buyer party's ledger — or, when routed "via CareOf"
// (Fish Mill / Factory), to the CareOf party instead, while the real buyer
// stays on the record. `amount` is the figure recognised as sale revenue and
// posted to the ledger (Market → Net Bill; Fish Mill → table total rate;
// Factory → bill amount total; Local → table total).
//
// Collection is NOT recorded here. What a party has settled comes from Receipt
// vouchers (see Settlement), so the outstanding figure is a property of the
// party's running ledger rather than of a single bill.
// Type-specific header fields all live here; only the relevant ones are set.
model Sale {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  centreId      String   @map("centre_id")
  type          SaleType
  partyId       String   @map("party_id") // the buyer
  careOfPartyId String?  @map("care_of_party_id") // ledger posts here when set
  billNo        String   @map("bill_no")
  /// THE ACCOUNTING DATE — the buying day this fish came from, not the day it
  /// was sold.
  ///
  /// Fish bought on the 16th is sold across the 17th and 18th, so a sale dated
  /// by when it happened would land in a day's profit that has none of the
  /// purchase behind it. Dating it by the purchase day instead means the Day
  /// Book for the 16th shows that catch's purchases, sales and expenses
  /// together, and the profit is the real one. Every ledger entry, statement,
  /// register and report reads this field and nothing else.
  date          DateTime @db.Date
  /// When the sale actually happened. Record only — deliberately read by no
  /// ledger, no report and no balance, so it can never move a figure. It exists
  /// because `date` above is now the purchase day, and the real date of the
  /// transaction would otherwise be lost. Null on rows entered before the two
  /// dates were separated, where `date` was both.
  saleDate      DateTime? @map("sale_date") @db.Date

  amount Decimal @db.Decimal(14, 2)

  /// The trip this bill came off. Required for MARKET, FACTORY and FISH_MILL —
  /// enforced in the action, not here, because LOCAL sales have no trip and a
  /// required column would block them.
  ///
  /// This is the link that replaces matching on date + vehicle text, which
  /// could never be reliable (spec invariant 8).
  deliveryNoteId String? @map("delivery_note_id")

  // --- Market deductions -------------------------------------------------
  // MARKET only. Factory, fish mill and local bills are paid in full and the
  // action rejects any of these on them.
  //
  // The market bill reads:
  //     Total bill − commission − labour/other − reserve − rent = Net bill
  //
  // Commission, labour and reserve stay NETTED INSIDE the net bill and are
  // never posted as separate expenses or income. Only the rent is grossed back
  // up, because it is settled through the transporter's account.

  /// Gross, before any deduction.
  totalBill  Decimal? @map("total_bill") @db.Decimal(14, 2)
  /// Commission the market charged BFM on this bill, in rupees.
  ///
  /// A COST, not income. BFM is a fish merchant, not a commission agent — it
  /// buys fish outright and owns it, and the market deducts its commission
  /// from what it pays. This is netted inside the net bill and must never be
  /// credited to a BFM account (spec invariant 4).
  ///
  /// Stored rather than derived: the rate is per-bill, so a bill struck at 2%
  /// must keep reading as 2% after the market changes its terms.
  commission Decimal? @db.Decimal(14, 2)
  /// The percentage `commission` was calculated at — 2.5 means 2.5%.
  ///
  /// Kept alongside the amount so a bill can show its own working ("2.5% of
  /// ₹1,20,000") rather than an unexplained figure. Null on rows entered
  /// before the rate became variable, which were all at the old fixed 2%.
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  /// Reserve the market withheld from this bill, collected by BFM at year end.
  ///
  /// Netted inside the net bill like the other deductions. Its BALANCE is
  /// derived per market party — SUM(sales.reserve) − SUM(reserve collections)
  /// — and is never pooled into one standing account (spec invariant 5).
  reserve    Decimal? @db.Decimal(14, 2)

  /// Labour and sundry deductions on a market bill.
  otherDeduction Decimal? @map("other_deduction") @db.Decimal(14, 2)

  /// This bill carries the trip's vehicle rent — the last market stop, which
  /// paid the driver the balance on BFM's behalf. At most one sale per trip
  /// may set this; enforced in the action.
  carriesRent  Boolean  @default(false) @map("carries_rent")
  /// Rent deducted on this bill. Set only when `carriesRent`, and may not
  /// exceed the trip's unsettled rent.
  ///
  /// This is the one deduction that is grossed back up: market revenue is
  /// `net bill + rentDeducted`, because the money did leave the business — it
  /// went to the transporter, through the market party (spec §2).
  rentDeducted Decimal? @map("rent_deducted") @db.Decimal(14, 2)
  place      String? // Market "Place"

  // Fish Mill-only:
  weight         Decimal? @db.Decimal(12, 3)
  netWeight      Decimal? @map("net_weight") @db.Decimal(12, 3)
  vehicleNo      String?  @map("vehicle_no")
  placeOfLoading String?  @map("place_of_loading")

  // Factory-only:
  returnNote String? @map("return_note")

  /// Free-form remark — see the note on Purchase.notes.
  notes      String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company     Company    @relation(fields: [companyId], references: [id])
  centre      Centre     @relation(fields: [centreId], references: [id])
  party       Party      @relation("SaleBuyer", fields: [partyId], references: [id])
  careOfParty Party?     @relation("SaleCareOf", fields: [careOfPartyId], references: [id])
  deliveryNote DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])
  createdBy   User?      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?      @relation("SaleUpdatedBy", fields: [updatedById], references: [id])
  lines       SaleLine[]

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, type])
  @@index([deliveryNoteId])
  /// At most one bill per trip may carry that trip's rent (spec §4). The
  /// actions check this too, but only as a read-then-write outside the
  /// transaction — two bills saved for one trip at the same moment both saw
  /// nothing and both saved, expensing the rent twice with no error. A partial
  /// unique index is the only race-free place to settle it. See the migration
  /// 20260824000000_one_rent_bearing_bill_per_trip; Prisma cannot express a
  /// partial index, so this stays a comment and the SQL is the definition.

  @@map("sales")
}

// Line items for Fish Mill and Local sales.
// Fish Mill: box · variety(particular) · kgs(qtyKg) · rate/kg · count · total.
// Local:     particular · qty(qtyKg) · rate/kg · total.
model SaleLine {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  particular String
  /// Box count. Fish Mill and MARKET both use it — a market bill is counted in
  /// boxes, and that count is what the trip reconciliation tallies against the
  /// boxes dispatched (spec §3.3).
  box        Int?
  /// On a FACTORY line this is the ACCEPTED weight, not the weight sent.
  /// Factories reweigh on arrival and pay for less; the gap against the trip's
  /// dispatched kilos is the rejection tally, and it has to be visible.
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  ratePerKg  Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  count      Int? // Fish Mill only
  total      Decimal @db.Decimal(14, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_lines")
}

// ---------- Settlements (payments & receipts) ----------

enum SettlementKind {
  PAYMENT // we pay a supplier — DEBITs their ledger
  RECEIPT // a customer pays us — CREDITs their ledger
}

enum SettlementMode {
  CASH
  BANK
  UPI
  CHEQUE
}

/**
 * A movement of money against a party, recorded as its own voucher.
 * This is deliberately separate from Purchase and Sale. Settlement used to be
 * implied by `Purchase.paid` and `Sale.amountReceived`, which posted a hidden
 * offsetting ledger row sharing the voucher's own id — so a purchase and its
 * payment were one indivisible record that could not be dated apart, paid in
 * instalments, or corrected independently. A trade and its settlement are
 * different events on different dates and each gets its own voucher.
 * Settlements are party-level, not bill-level: a receipt reduces what the
 * party owes across the whole relationship rather than being allocated to one
 * invoice. That matches how the running outstanding is read off the statement.
 */
model Settlement {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  centreId    String         @map("centre_id")
  partyId     String         @map("party_id")
  kind        SettlementKind
  mode        SettlementMode @default(CASH)
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime       @db.Date
  /// Cheque number, UPI reference, slip number — free text.
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @map("updated_at")
  createdById String?        @map("created_by_id")
  updatedById String?        @map("updated_by_id")

  company   Company @relation(fields: [companyId], references: [id])
  centre    Centre  @relation(fields: [centreId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("SettlementUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, partyId])
  @@map("settlements")
}

// ---------- Ledger ----------

/// Reserve money actually collected back from a market party.
///
/// Deliberately NOT a ledger entry and NOT a Settlement. Reserve never sat in
/// the trade ledger — it is netted inside a market bill — so collecting it
/// settles nothing there. What it does is clear the DERIVED reserve balance for
/// that party (sales less collections) and recognise the money as income, in
/// the net-profit tier only, on the day it was actually collected.
///
/// `date` here is the one date in the system that is NOT a buying day: the
/// money arrives when it arrives, usually at year end.
model ReserveCollection {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  centreId    String         @map("centre_id")
  partyId     String         @map("party_id")
  amount      Decimal        @db.Decimal(14, 2)
  /// The day the money was actually collected — NOT a buying day.
  date        DateTime       @db.Date
  mode        SettlementMode @default(CASH)
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  createdById String?        @map("created_by_id")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  @@index([companyId, centreId, partyId])
  @@map("reserve_collections")
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  PURCHASE
  SALE
  EXPENSE
  PAYMENT // money out — settles what we owe a supplier
  RECEIPT // money in — settles what a customer owes us
  RENT // credit to the transporter when a trip is created — the rent owed for
  // that trip, expensed once on the buying day
  RENT_BY_PARTY // a market party paid the driver on BFM's behalf. Debits the
  // transporter (settling his rent) and credits the market party (who is not
  // out of pocket), so the trip's rent closes without a second expense
  COMMISSION // RETIRED — never post again. Commission is a cost the market
  // charges BFM and is netted inside the bill; it was previously credited to a
  // BFM account, which read as income the business never earned.
  RESERVE // RETIRED — never post again. Reserve is derived per market party
  // from sales less collections, never posted to a pooled account.
}

// One generic ledger table powers every party statement — no per-party-type
// ledger tables. Sign convention: positive = party owes us, negative = we owe
// the party. DEBIT increases the balance, CREDIT decreases it.
model LedgerEntry {
  id             String           @id @default(uuid())
  // Monotonic insertion order. `created_at` only has millisecond precision, so
  // entries written inside one transaction can tie — and a tie makes the
  // running-balance window function non-deterministic, which is what let
  // statements drift. (date, seq) is a total order, so a recompute always
  // produces the same chain. Not a primary key; the uuid `id` stays.
  seq            Int              @unique @default(autoincrement())
  companyId      String           @map("company_id")
  centreId       String           @map("centre_id")
  partyId        String           @map("party_id")
  type           LedgerEntryType
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String           @map("source_id")
  amount         Decimal          @db.Decimal(14, 2)
  date           DateTime         @db.Date
  runningBalance Decimal          @map("running_balance") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  // Covers both the statement read (ordered by date, seq) and the recompute
  // window, which partitions on exactly this key.
  @@index([companyId, centreId, partyId, date, seq])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

// ---------- Attachments ----------

enum AttachmentLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

model Attachment {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  centreId   String               @map("centre_id")
  linkedType AttachmentLinkedType @map("linked_type")
  linkedId   String               @map("linked_id")
  storageKey String               @map("storage_key")
  uploadedAt DateTime             @default(now()) @map("uploaded_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@index([linkedType, linkedId])
  @@map("attachments")
}

// ---------- Review requests ----------

// Which voucher a review request points at. PAYMENT and RECEIPT are both rows
// in `settlements`; they are kept apart here because they live under different
// URLs and read as different vouchers to the people using them.
enum ReviewLinkedType {
  PURCHASE
  SALE
  EXPENSE
  DELIVERY_NOTE
  PAYMENT
  RECEIPT
}

enum ReviewStatus {
  OPEN
  RESOLVED
}

/**
 * An accountant asking an admin to correct a voucher.
 *
 * An accountant may enter a voucher but never edit one (see Role), so a typo
 * discovered after saving had no route back — the entry simply stayed wrong.
 * This is that route: the accountant raises a request naming what is wrong, and
 * it surfaces on the admin's dashboard under the company and centre the voucher
 * was entered in.
 *
 * The scope is copied from the voucher row itself, not from whatever scope the
 * requester happens to be sitting in, so a request always files against the
 * centre that owns the entry.
 *
 * Requests close by themselves: the next admin edit (or delete) of that voucher
 * marks every open request against it RESOLVED. Nothing here is deleted when a
 * voucher is — the request is the record that a correction was asked for, and
 * that outlives the row it was about.
 *
 * At most one request per voucher may be OPEN at a time; the create action
 * enforces that inside its transaction. Resolved ones accumulate, so the same
 * voucher can be queried about more than once over its life.
 */
model ReviewRequest {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  centreId      String           @map("centre_id")
  linkedType    ReviewLinkedType @map("linked_type")
  linkedId      String           @map("linked_id")
  status        ReviewStatus     @default(OPEN)
  /// What the accountant says is wrong. Required — a request with no reason
  /// gives the admin nothing to act on.
  reason        String
  requestedById String?          @map("requested_by_id")
  requestedAt   DateTime         @default(now()) @map("requested_at")
  resolvedById  String?          @map("resolved_by_id")
  resolvedAt    DateTime?        @map("resolved_at")

  company     Company @relation(fields: [companyId], references: [id])
  centre      Centre  @relation(fields: [centreId], references: [id])
  requestedBy User?   @relation("ReviewRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?   @relation("ReviewResolvedBy", fields: [resolvedById], references: [id])

  // The dashboard read: open requests for one company and centre, newest first.
  @@index([companyId, centreId, status, requestedAt])
  // The voucher read: does this voucher have an open request against it?
  @@index([linkedType, linkedId, status])
  @@map("review_requests")
}

/// The next number in one of BFM's own document series.
///
/// Only for documents BFM ORIGINATES: a delivery note, a private or local
/// purchase (there is no supplier bill to copy a number from), and a local
/// sale. A Society or KFDC bill, and a factory, market or fish-mill sale, all
/// arrive with a number already on them — those stay typed, because inventing
/// our own would lose the one the counterparty will quote back at us.
///
/// A counter row rather than max(bill_no) + 1: two clerks saving at the same
/// moment would both read the same maximum and both write the same number.
/// Incrementing this row inside the voucher's own transaction serialises them,
/// and the unique index below is the backstop if anything ever slips past.
model DocumentSeries {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  /// DN, PP, LP, LS.
  prefix    String
  /// The number the NEXT document will take.
  next      Int    @default(1)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, prefix])
  @@map("document_series")
}

// ---------- Corrections ----------

// Day closing (the DayClose model and its `day_closes` table) was removed
// entirely in 20260817000000_drop_day_closes. It had been retired long before
// that — an Admin may edit any voucher at any time, and only an Admin may edit
// at all — and the table was kept only in case the feature was revived. It never
// was, nothing read or wrote it, and it held no rows in production, so the dead
// schema went with the dead code.

// ErrorFlag and ErrorFlagLinkedType were deleted here (spec §3.7).
//
// They belonged to the closed-day correction flow: once a day was closed you
// could not edit its vouchers, so a mistake was flagged and superseded instead.
// Day closing was removed, an Admin now edits any voucher at any time, and
// nothing has created a flag since. The read path that rendered flagged rows
// struck through went with them.
