// FMS schema — simplified 3-module model (Purchase / Expense / Sale).
// The app is a ledger: totals are entered, the bill image carries the detail,
// and each party (boat, seller, buyer, expense vendor) gets an auto-built
// running ledger. No inventory/stock accounting — Profit = Sale − (Purchase +
// Expense).
//
// All primary keys are UUIDs generated client-side (Prisma @default(uuid())
// runs in the client, not the database) — kept for future offline support.
// Never switch these to autoincrement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  ADMIN // full access; the only role that may edit an existing voucher
  ACCOUNTANT // may enter vouchers and manage parties, but never edit a voucher
  AUDITOR // read-only; no voucher menu, drill-down from ledgers only
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  // Accounts are deactivated, never deleted — vouchers reference their author
  // and that history has to survive someone leaving.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  purchasesCreated     Purchase[]     @relation("PurchaseCreatedBy")
  purchasesUpdated     Purchase[]     @relation("PurchaseUpdatedBy")
  expensesCreated      Expense[]      @relation("ExpenseCreatedBy")
  expensesUpdated      Expense[]      @relation("ExpenseUpdatedBy")
  salesCreated         Sale[]         @relation("SaleCreatedBy")
  salesUpdated         Sale[]         @relation("SaleUpdatedBy")
  deliveryNotesCreated DeliveryNote[] @relation("DeliveryNoteCreatedBy")
  deliveryNotesUpdated DeliveryNote[] @relation("DeliveryNoteUpdatedBy")
  settlementsCreated   Settlement[]   @relation("SettlementCreatedBy")
  settlementsUpdated   Settlement[]   @relation("SettlementUpdatedBy")

  @@map("users")
}

// ---------- Core ----------

model Company {
  id        String   @id @default(uuid())
  name      String   @unique // "BFM" / "B2B"
  createdAt DateTime @default(now()) @map("created_at")

  centres       Centre[]
  purchases     Purchase[]
  deliveryNotes DeliveryNote[]
  sales         Sale[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  attachments   Attachment[]
  dayCloses     DayClose[]
  settlements   Settlement[]

  @@map("companies")
}

// A centre is a fully isolated ledger/transaction scope inside a company
// (added via Masters). Every transaction and ledger entry is stamped with both
// company_id and centre_id; balances are derived per (company, centre, party).
// P/L is deliberately NOT computed per centre — the merchant splits purchase
// and sale across centres, so P/L aggregates at the company (and union) level.
model Centre {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id])
  purchases     Purchase[]
  deliveryNotes DeliveryNote[]
  sales         Sale[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  attachments   Attachment[]
  dayCloses     DayClose[]
  settlements   Settlement[]

  @@unique([companyId, name])
  @@map("centres")
}

// Every ledger is keyed to a Party. Boat/seller names are typed on the
// purchase and resolved to a Party (find-or-create by name+type); buyers and
// expense vendors work the same way. Global, NOT company-scoped — shared
// across BFM and B2B. Balances are never stored here; they are derived from
// LedgerEntry per company.
enum PartyType {
  BOAT // the vessel named on a Society / KFDC / Private purchase. A name
  // registry only — nothing ever posts a LedgerEntry against it, because the
  // money is owed to the party that sent the boat, not to the boat.
  LOCAL_SELLER // "Name" on a Local purchase. Also registry-only.
  MARKET_BUYER
  FACTORY
  FISH_MILL
  LOCAL_BUYER
  EXPENSE_VENDOR // ice plant, landlord, loaders group, etc.
  CARE_OF // commission agent who pays immediately; a Fish Mill/Factory sale
  // "via CareOf" keeps the real buyer on the sale record but posts the ledger
  // to this CareOf party instead.
  PURCHASE_GROUP // whoever a purchase is owed to. Society, KFDC and Local
  // Individuals are one standing account each, fixed by the purchase type;
  // a Private purchase names its own owner, who gets a ledger of their own.
  // The individual boat is recorded on the purchase as a column, never as a
  // ledger. See src/lib/party.ts (FIXED_PURCHASE_PARTY).
  COMMISSION // the house's own 2% commission account — one per company/centre,
  // credited by every Market sale. Modelled as a party so the commission
  // ledger is an ordinary statement rather than a parallel reporting table.
}

model Party {
  id          String    @id @default(uuid())
  name        String
  type        PartyType
  contactInfo String?   @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")

  purchases       Purchase[]
  purchasesAsBoat Purchase[]    @relation("PurchaseBoat")
  expenses        Expense[]
  ledgerEntries   LedgerEntry[]
  salesAsBuyer    Sale[]        @relation("SaleBuyer")
  salesAsCareOf   Sale[]        @relation("SaleCareOf")
  settlements     Settlement[]

  @@unique([name, type])
  @@map("parties")
}

// ---------- Purchases ----------

enum PurchaseType {
  SOCIETY
  KFDC
  PRIVATE
  LOCAL
}

// Society / KFDC / Private: party is the boat, amount is the grand total, and
// the fish breakdown lives in the attached bill image. Local: party is the
// seller ("Name"), amount is the sum of its line items.
model Purchase {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  centreId    String       @map("centre_id")
  /// The ledger this purchase settles against: Society, KFDC, Local
  /// Individuals, or — for a Private purchase — the named owner. NOT the boat,
  /// see `boatId`.
  partyId     String       @map("party_id")
  /// The individual boat (Society/KFDC/Private) or seller (Local). Recorded so
  /// every statement row can name it, but it carries no ledger of its own:
  /// money is owed to the group, not to the vessel.
  boatId      String?      @map("boat_id")
  type        PurchaseType
  amount      Decimal      @db.Decimal(14, 2)
  date        DateTime     @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  // Null updatedAt means "never edited" — that is why this is not @updatedAt,
  // which would also fire on insert.
  updatedAt   DateTime?    @map("updated_at")
  createdById String?      @map("created_by_id")
  updatedById String?      @map("updated_by_id")

  company   Company        @relation(fields: [companyId], references: [id])
  centre    Centre         @relation(fields: [centreId], references: [id])
  party     Party          @relation(fields: [partyId], references: [id])
  boat      Party?         @relation("PurchaseBoat", fields: [boatId], references: [id])
  createdBy User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?          @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  lines     PurchaseLine[]

  @@index([companyId, centreId, date])
  @@index([boatId])
  @@map("purchases")
}

// Itemised rows for a LOCAL purchase only (spec: Name · Particular · Quantity
// · Price/kg · Total). Society/KFDC/Private purchases have no lines.
model PurchaseLine {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  particular String
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_lines")
}

// ---------- Expenses ----------

enum ExpenseCategory {
  ICE
  LOADERS
  LADIES
  BATHA
  CANTEEN
  RENT
}

// One row per expense. `details` holds the per-category fields (ICE: vehicle,
// plant, blocks, rate; Loaders/Ladies: boxes, rate; Rent: vehicle; etc.);
// `amount` is always the total that flows to the ledger and the Profit report.
model Expense {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  centreId    String          @map("centre_id")
  partyId     String          @map("party_id") // expense vendor / category ledger
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  details     Json?
  notes       String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime?       @map("updated_at")
  createdById String?         @map("created_by_id")
  updatedById String?         @map("updated_by_id")

  company   Company @relation(fields: [companyId], references: [id])
  centre    Centre  @relation(fields: [centreId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, centreId, category, date])
  @@map("expenses")
}

// ---------- Delivery Notes (record only) ----------

// A delivery note is a pure dispatch record — no ledger, no settlement, no
// money movement. Header fields + line items + an optional bill image. Column
// totals (box / big box / loose / pcs) are summed on the fly for display; the
// note itself carries no accounting.
model DeliveryNote {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  centreId    String    @map("centre_id")
  billNo      String    @map("bill_no")
  date        DateTime  @db.Date
  recipient   String // the "To" field
  vehicleNo   String    @map("vehicle_no")
  advancePaid Decimal?  @map("advance_paid") @db.Decimal(14, 2)
  driverName  String?   @map("driver_name")
  mobileNo    String?   @map("mobile_no")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company   Company            @relation(fields: [companyId], references: [id])
  centre    Centre             @relation(fields: [centreId], references: [id])
  createdBy User?              @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("DeliveryNoteUpdatedBy", fields: [updatedById], references: [id])
  lines     DeliveryNoteLine[]

  @@index([companyId, centreId, date])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String  @id @default(uuid())
  deliveryNoteId String  @map("delivery_note_id")
  particulars    String
  kg             Decimal @default(0) @db.Decimal(12, 3)
  box            Int     @default(0)
  bigBox         Int     @default(0) @map("big_box")
  loose          Int     @default(0)
  pcs            Int     @default(0)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------- Sales ----------

enum SaleType {
  MARKET
  FISH_MILL
  FACTORY
  LOCAL
}

// A sale posts to the buyer party's ledger — or, when routed "via CareOf"
// (Fish Mill / Factory), to the CareOf party instead, while the real buyer
// stays on the record. `amount` is the figure recognised as sale revenue and
// posted to the ledger (Market → Net Bill; Fish Mill → table total rate;
// Factory → bill amount total; Local → table total).
//
// Collection is NOT recorded here. What a party has settled comes from Receipt
// vouchers (see Settlement), so the outstanding figure is a property of the
// party's running ledger rather than of a single bill.
// Type-specific header fields all live here; only the relevant ones are set.
model Sale {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  centreId      String   @map("centre_id")
  type          SaleType
  partyId       String   @map("party_id") // the buyer
  careOfPartyId String?  @map("care_of_party_id") // ledger posts here when set
  billNo        String   @map("bill_no")
  date          DateTime @db.Date

  amount Decimal @db.Decimal(14, 2)

  // Market-only (recorded/displayed, not posted):
  totalBill  Decimal? @map("total_bill") @db.Decimal(14, 2) // gross incl. seller profit + expenses
  commission Decimal? @db.Decimal(14, 2) // 2% of totalBill, reference only
  place      String? // Market "Place"

  // Fish Mill-only:
  weight         Decimal? @db.Decimal(12, 3)
  netWeight      Decimal? @map("net_weight") @db.Decimal(12, 3)
  vehicleNo      String?  @map("vehicle_no")
  placeOfLoading String?  @map("place_of_loading")

  // Factory-only:
  returnNote String? @map("return_note")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company     Company    @relation(fields: [companyId], references: [id])
  centre      Centre     @relation(fields: [centreId], references: [id])
  party       Party      @relation("SaleBuyer", fields: [partyId], references: [id])
  careOfParty Party?     @relation("SaleCareOf", fields: [careOfPartyId], references: [id])
  createdBy   User?      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?      @relation("SaleUpdatedBy", fields: [updatedById], references: [id])
  lines       SaleLine[]

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, type])
  @@map("sales")
}

// Line items for Fish Mill and Local sales.
// Fish Mill: box · variety(particular) · kgs(qtyKg) · rate/kg · count · total.
// Local:     particular · qty(qtyKg) · rate/kg · total.
model SaleLine {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  particular String
  box        Int? // Fish Mill only
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  ratePerKg  Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  count      Int? // Fish Mill only
  total      Decimal @db.Decimal(14, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_lines")
}

// ---------- Settlements (payments & receipts) ----------

enum SettlementKind {
  PAYMENT // we pay a supplier — DEBITs their ledger
  RECEIPT // a customer pays us — CREDITs their ledger
}

enum SettlementMode {
  CASH
  BANK
  UPI
  CHEQUE
}

/**
 * A movement of money against a party, recorded as its own voucher.
 * This is deliberately separate from Purchase and Sale. Settlement used to be
 * implied by `Purchase.paid` and `Sale.amountReceived`, which posted a hidden
 * offsetting ledger row sharing the voucher's own id — so a purchase and its
 * payment were one indivisible record that could not be dated apart, paid in
 * instalments, or corrected independently. A trade and its settlement are
 * different events on different dates and each gets its own voucher.
 * Settlements are party-level, not bill-level: a receipt reduces what the
 * party owes across the whole relationship rather than being allocated to one
 * invoice. That matches how the running outstanding is read off the statement.
 */
model Settlement {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  centreId    String         @map("centre_id")
  partyId     String         @map("party_id")
  kind        SettlementKind
  mode        SettlementMode @default(CASH)
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime       @db.Date
  /// Cheque number, UPI reference, slip number — free text.
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @map("updated_at")
  createdById String?        @map("created_by_id")
  updatedById String?        @map("updated_by_id")

  company   Company @relation(fields: [companyId], references: [id])
  centre    Centre  @relation(fields: [centreId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("SettlementUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, partyId])
  @@map("settlements")
}

// ---------- Ledger ----------

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  PURCHASE
  SALE
  EXPENSE
  PAYMENT // money out — settles what we owe a supplier
  RECEIPT // money in — settles what a customer owes us
  COMMISSION // 2% agent commission earned on a Market sale
}

// One generic ledger table powers every party statement — no per-party-type
// ledger tables. Sign convention: positive = party owes us, negative = we owe
// the party. DEBIT increases the balance, CREDIT decreases it.
model LedgerEntry {
  id             String           @id @default(uuid())
  // Monotonic insertion order. `created_at` only has millisecond precision, so
  // entries written inside one transaction can tie — and a tie makes the
  // running-balance window function non-deterministic, which is what let
  // statements drift. (date, seq) is a total order, so a recompute always
  // produces the same chain. Not a primary key; the uuid `id` stays.
  seq            Int              @unique @default(autoincrement())
  companyId      String           @map("company_id")
  centreId       String           @map("centre_id")
  partyId        String           @map("party_id")
  type           LedgerEntryType
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String           @map("source_id")
  amount         Decimal          @db.Decimal(14, 2)
  date           DateTime         @db.Date
  runningBalance Decimal          @map("running_balance") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  // Covers both the statement read (ordered by date, seq) and the recompute
  // window, which partitions on exactly this key.
  @@index([companyId, centreId, partyId, date, seq])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

// ---------- Attachments ----------

enum AttachmentLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

model Attachment {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  centreId   String               @map("centre_id")
  linkedType AttachmentLinkedType @map("linked_type")
  linkedId   String               @map("linked_id")
  storageKey String               @map("storage_key")
  uploadedAt DateTime             @default(now()) @map("uploaded_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@index([linkedType, linkedId])
  @@map("attachments")
}

// ---------- Day close & corrections ----------

// RETIRED. Day closing was removed from the application: an Admin may edit any
// voucher at any time, and only an Admin may edit at all. The table is kept so
// no historic rows are destroyed and the feature can be revived, but nothing
// writes to it and nothing reads it any more.
model DayClose {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  centreId  String   @map("centre_id")
  date      DateTime @db.Date
  closedAt  DateTime @default(now()) @map("closed_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@unique([companyId, centreId, date])
  @@map("day_closes")
}

enum ErrorFlagLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

// RETIRED alongside DayClose — nothing creates flags any more. Existing rows
// are still read: a flagged voucher stays visible, struck through, links to
// whatever replaced it, and is excluded from report totals.
model ErrorFlag {
  id                String              @id @default(uuid())
  linkedType        ErrorFlagLinkedType @map("linked_type")
  linkedId          String              @map("linked_id")
  flaggedAt         DateTime            @default(now()) @map("flagged_at")
  reason            String?
  correctingEntryId String?             @map("correcting_entry_id")

  @@unique([linkedType, linkedId])
  @@map("error_flags")
}
