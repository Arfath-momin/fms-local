// FMS schema — simplified 3-module model (Purchase / Expense / Sale).
// The app is a ledger: totals are entered, the bill image carries the detail,
// and each party (boat, seller, buyer, expense vendor) gets an auto-built
// running ledger. No inventory/stock accounting — Profit = Sale − (Purchase +
// Expense).
//
// All primary keys are UUIDs generated client-side (Prisma @default(uuid())
// runs in the client, not the database) — kept for future offline support.
// Never switch these to autoincrement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  SUPER_ADMIN // everything ADMIN can do, plus the irreversible operations the
  // merchant is deliberately kept away from: unarchiving a master, and really
  // deleting one. Never grantable from inside the app — see
  // scripts/create-user.ts — so a merchant admin cannot promote themselves.
  ADMIN // full access; the only role that may edit an existing voucher
  ACCOUNTANT // may enter vouchers and manage parties, but never edit a voucher
  AUDITOR // read-only; no voucher menu, drill-down from ledgers only
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  // Accounts are deactivated, never deleted — vouchers reference their author
  // and that history has to survive someone leaving.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  purchasesCreated     Purchase[]      @relation("PurchaseCreatedBy")
  purchasesUpdated     Purchase[]      @relation("PurchaseUpdatedBy")
  expensesCreated      Expense[]       @relation("ExpenseCreatedBy")
  expensesUpdated      Expense[]       @relation("ExpenseUpdatedBy")
  salesCreated         Sale[]          @relation("SaleCreatedBy")
  salesUpdated         Sale[]          @relation("SaleUpdatedBy")
  deliveryNotesCreated DeliveryNote[]  @relation("DeliveryNoteCreatedBy")
  deliveryNotesUpdated DeliveryNote[]  @relation("DeliveryNoteUpdatedBy")
  settlementsCreated   Settlement[]    @relation("SettlementCreatedBy")
  settlementsUpdated   Settlement[]    @relation("SettlementUpdatedBy")
  reviewsRequested     ReviewRequest[] @relation("ReviewRequestedBy")
  reviewsResolved      ReviewRequest[] @relation("ReviewResolvedBy")
  companies            UserCompany[]

  @@map("users")
}

/// Which companies an account may work in.
///
/// BFM and B2B share this installation but are separate businesses with
/// separate partners, so an admin of one has no business reading the other's
/// ledgers. A grant is the whole of that permission: the company switcher shows
/// only what the user holds, and getActiveCompany() refuses a cookie naming a
/// company they do not — which is what makes this an actual boundary rather
/// than a hidden menu.
///
/// SUPER_ADMIN needs no rows here and is never filtered; the system owner sees
/// every company by definition.
model UserCompany {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@map("user_companies")
}

// ---------- Core ----------

model Company {
  id        String   @id @default(uuid())
  name      String   @unique // "BFM" / "B2B"
  /// The colour of this company's band and switcher chip, as `#rrggbb`.
  ///
  /// Company identity is the app's first design rule — you must never be in
  /// doubt whose books are on screen. That used to be two hardcoded CSS rules
  /// keyed on the names BFM and B2B, which meant a third company rendered in
  /// the default blue and looked exactly like BFM. Storing it makes the colour
  /// a property of the company rather than of the stylesheet.
  ///
  /// Null falls back to the stylesheet, which is what rows created before this
  /// column do.
  colour    String?  @db.VarChar(7)

  // --- Letterhead ---------------------------------------------------------
  // Printed at the top of every sale bill and delivery note. All optional: a
  // company with none of it still prints, just with the short name alone, so
  // adding a company never blocks on paperwork details nobody has to hand yet.

  /// The registered name, when it differs from the short one used in the UI —
  /// "Bismillah Fish Merchants" against a switcher that reads "BFM". Printed
  /// in place of `name` on documents when set.
  legalName     String? @map("legal_name")
  /// Free-form, newlines preserved — Indian addresses do not fit a fixed shape.
  address       String?
  phone         String?
  email         String?
  /// Who to ask for. Printed on the bill so a buyer with a query has a name.
  contactPerson String? @map("contact_person")
  /// GST identification number, printed on documents where quoted.
  gstin         String?
  /// Storage key of the logo in the same image store as bill photos (see
  /// src/lib/attachments.ts). A key rather than a foreign key to Attachment:
  /// that model requires a centreId, and a company logo belongs to no centre.
  logoKey       String? @map("logo_key")

  createdAt DateTime @default(now()) @map("created_at")

  centres        Centre[]
  users          UserCompany[]
  purchases      Purchase[]
  deliveryNotes  DeliveryNote[]
  sales          Sale[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  attachments    Attachment[]
  dayCloses      DayClose[]
  settlements    Settlement[]
  reviewRequests ReviewRequest[]

  @@map("companies")
}

// A centre is a fully isolated ledger/transaction scope inside a company
// (added via Masters). Every transaction and ledger entry is stamped with both
// company_id and centre_id; balances are derived per (company, centre, party).
// P/L is deliberately NOT computed per centre — the merchant splits purchase
// and sale across centres, so P/L aggregates at the company (and union) level.
model Centre {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  /// Set when the centre is retired. Every transaction below still points here
  /// and every ledger, register and report reads exactly as before — an
  /// archived centre simply stops being offered in the switcher and the entry
  /// screens, so nothing new can land in it. Deletion is reserved for centres
  /// that were never used at all.
  archivedAt DateTime? @map("archived_at")

  company        Company         @relation(fields: [companyId], references: [id])
  purchases      Purchase[]
  deliveryNotes  DeliveryNote[]
  sales          Sale[]
  expenses       Expense[]
  ledgerEntries  LedgerEntry[]
  attachments    Attachment[]
  dayCloses      DayClose[]
  settlements    Settlement[]
  reviewRequests ReviewRequest[]

  @@unique([companyId, name])
  @@map("centres")
}

// Every ledger is keyed to a Party. Boat/seller names are typed on the
// purchase and resolved to a Party (find-or-create by name+type); buyers and
// expense vendors work the same way. Global, NOT company-scoped — shared
// across BFM and B2B. Balances are never stored here; they are derived from
// LedgerEntry per company.
enum PartyType {
  BOAT // the vessel named on each line of a Society / KFDC purchase. A name
  // registry only — nothing ever posts a LedgerEntry against it, because the
  // money is owed to the party that sent the boat, not to the boat.
  LOCAL_SELLER // RETIRED. Local sellers used to be registry-only names hung off
  // a single shared "Local Individuals" ledger, which meant two sellers owed
  // ₹40k and ₹50k read as one ₹90k debt to nobody in particular. A Local
  // purchase now names its seller as a PURCHASE_GROUP with a ledger of their
  // own, exactly like a Private one. Kept so historic rows still resolve.
  MARKET_BUYER
  FACTORY
  FISH_MILL
  LOCAL_BUYER
  EXPENSE_VENDOR // ice plant, landlord, loaders group, etc.
  CARE_OF // commission agent who pays immediately; a Fish Mill/Factory sale
  // "via CareOf" keeps the real buyer on the sale record but posts the ledger
  // to this CareOf party instead.
  PURCHASE_GROUP // whoever a purchase is owed to. Society and KFDC are one
  // standing account each, fixed by the purchase type, however many boats they
  // send; a Private or Local purchase names its own seller, who gets a ledger
  // of their own so payments settle against the right person. The individual
  // boat is recorded on the line, never as a ledger. See src/lib/party.ts
  // (FIXED_PURCHASE_PARTY).
  COMMISSION // the house's own 2% commission account — one per company/centre,
  // credited by every Market sale. Modelled as a party so the commission
  // ledger is an ordinary statement rather than a parallel reporting table.
}

model Party {
  id          String    @id @default(uuid())
  name        String
  type        PartyType
  contactInfo String?   @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Set when the party is retired. It vanishes from the pickers and the master
  /// list but keeps every voucher and ledger entry it ever had, which is why
  /// this is a timestamp and not a delete. Note the (name, type) unique below
  /// still applies to archived rows: typing the name again resolves to this
  /// party and revives it, rather than starting a second ledger from zero.
  archivedAt  DateTime? @map("archived_at")
  /// Which kind of purchase this party sells through — PURCHASE_GROUP only.
  ///
  /// Society, KFDC and every private and local seller share one party type,
  /// because they share one thing that matters to the ledger: the money is owed
  /// to them. But that made the purchase form suggest all of them at once, so
  /// entering a Private bill offered KFDC and every local seller too. This
  /// narrows the suggestions without splitting the type the ledger is keyed on.
  ///
  /// Null on every other party type, and on a purchase party that predates the
  /// backfill or was created by hand from Masters.
  purchaseKind PurchaseType? @map("purchase_kind")

  purchases           Purchase[]
  purchasesAsBoat     Purchase[]     @relation("PurchaseBoat")
  purchaseLinesAsBoat PurchaseLine[] @relation("PurchaseLineBoat")
  expenses            Expense[]
  ledgerEntries       LedgerEntry[]
  salesAsBuyer        Sale[]         @relation("SaleBuyer")
  salesAsCareOf       Sale[]         @relation("SaleCareOf")
  settlements         Settlement[]

  @@unique([name, type])
  @@map("parties")
}

// ---------- Purchases ----------

enum PurchaseType {
  SOCIETY
  KFDC
  PRIVATE
  LOCAL
}

// Every purchase is itemised, and `amount` is always the sum of its lines —
// never typed in. Society / KFDC name the boat on each line (one bill can cover
// several vessels); Private / Local name the seller once, in `partyId`, because
// that is who the money is owed to.
model Purchase {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  centreId    String       @map("centre_id")
  /// The ledger this purchase settles against: Society, KFDC, or — for a
  /// Private or Local purchase — the named individual seller. NOT the boat.
  partyId     String       @map("party_id")
  /// The "No." on a Society/KFDC bill, the "Invoice No." on a Private/Local
  /// one — the same field under two names on paper. Deliberately not unique:
  /// real bill books repeat numbers across centres and across years.
  billNo      String?      @map("bill_no")
  /// RETIRED for new entries — the boat now lives on the line (see
  /// PurchaseLine.boatId), because one Society bill covers several vessels.
  /// Still written by nothing and read by the party statement, which falls back
  /// to it for purchases entered before the line-level boat existed.
  boatId      String?      @map("boat_id")
  type        PurchaseType
  amount      Decimal      @db.Decimal(14, 2)
  date        DateTime     @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  // Null updatedAt means "never edited" — that is why this is not @updatedAt,
  // which would also fire on insert.
  updatedAt   DateTime?    @map("updated_at")
  createdById String?      @map("created_by_id")
  updatedById String?      @map("updated_by_id")

  company   Company        @relation(fields: [companyId], references: [id])
  centre    Centre         @relation(fields: [centreId], references: [id])
  party     Party          @relation(fields: [partyId], references: [id])
  boat      Party?         @relation("PurchaseBoat", fields: [boatId], references: [id])
  createdBy User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?          @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  lines     PurchaseLine[]

  @@index([companyId, centreId, date])
  @@index([boatId])
  @@map("purchases")
}

// One row of a purchase bill.
//
//   Society / KFDC   Boat · Particulars · Total Kg · Rate/kg · Amount
//   Private / Local  Particular · Qty · Rate · Amount
//
// `boatId` is therefore set on Society/KFDC lines and null on Private/Local
// ones, where the seller is the purchase's party rather than a per-line detail.
// Like the old header boat it is a name registry only: nothing posts a
// LedgerEntry against a vessel, because the money is owed to the party that
// sent it.
model PurchaseLine {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  boatId     String? @map("boat_id")
  particular String
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  boat     Party?   @relation("PurchaseLineBoat", fields: [boatId], references: [id])

  @@index([purchaseId])
  @@index([boatId])
  @@map("purchase_lines")
}

// ---------- Expenses ----------

enum ExpenseCategory {
  ICE
  LOADERS
  LADIES
  BATHA
  CANTEEN
  RENT
}

// One row per expense. `details` holds the per-category fields (ICE: vehicle,
// plant, blocks, rate; Loaders/Ladies: boxes, rate; Rent: vehicle; etc.);
// `amount` is always the total that flows to the ledger and the Profit report.
model Expense {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  centreId    String          @map("centre_id")
  partyId     String          @map("party_id") // expense vendor / category ledger
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  details     Json?
  notes       String?
  /// THE ACCOUNTING DATE — the buying day this cost belongs to. Ice bought on
  /// the 17th for the 16th's catch is dated the 16th, so it lands in that
  /// day's profit alongside the purchase it was spent on. Read by the ledger,
  /// the Day Book and every report.
  date        DateTime        @db.Date
  /// When the money actually went out. Record only, read by nothing that
  /// computes a figure — the counterpart to Sale.saleDate. Null on rows from
  /// before the two dates were separated.
  spentOn     DateTime?       @map("spent_on") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime?       @map("updated_at")
  createdById String?         @map("created_by_id")
  updatedById String?         @map("updated_by_id")

  company   Company @relation(fields: [companyId], references: [id])
  centre    Centre  @relation(fields: [centreId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, centreId, category, date])
  @@map("expenses")
}

// ---------- Delivery Notes (record only) ----------

// A delivery note is a pure dispatch record — no ledger, no settlement, no
// money movement. Header fields + line items + an optional bill image. Column
// totals (box / big box / loose / pcs) are summed on the fly for display; the
// note itself carries no accounting.
model DeliveryNote {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  centreId    String    @map("centre_id")
  billNo      String    @map("bill_no")
  date        DateTime  @db.Date
  recipient   String // the "To" field
  vehicleNo   String    @map("vehicle_no")
  advancePaid Decimal?  @map("advance_paid") @db.Decimal(14, 2)
  driverName  String?   @map("driver_name")
  mobileNo    String?   @map("mobile_no")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company   Company            @relation(fields: [companyId], references: [id])
  centre    Centre             @relation(fields: [centreId], references: [id])
  createdBy User?              @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("DeliveryNoteUpdatedBy", fields: [updatedById], references: [id])
  lines     DeliveryNoteLine[]

  @@index([companyId, centreId, date])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String  @id @default(uuid())
  deliveryNoteId String  @map("delivery_note_id")
  particulars    String
  kg             Decimal @default(0) @db.Decimal(12, 3)
  box            Int     @default(0)
  bigBox         Int     @default(0) @map("big_box")
  loose          Int     @default(0)
  pcs            Int     @default(0)

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------- Sales ----------

enum SaleType {
  MARKET
  FISH_MILL
  FACTORY
  LOCAL
}

// A sale posts to the buyer party's ledger — or, when routed "via CareOf"
// (Fish Mill / Factory), to the CareOf party instead, while the real buyer
// stays on the record. `amount` is the figure recognised as sale revenue and
// posted to the ledger (Market → Net Bill; Fish Mill → table total rate;
// Factory → bill amount total; Local → table total).
//
// Collection is NOT recorded here. What a party has settled comes from Receipt
// vouchers (see Settlement), so the outstanding figure is a property of the
// party's running ledger rather than of a single bill.
// Type-specific header fields all live here; only the relevant ones are set.
model Sale {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  centreId      String   @map("centre_id")
  type          SaleType
  partyId       String   @map("party_id") // the buyer
  careOfPartyId String?  @map("care_of_party_id") // ledger posts here when set
  billNo        String   @map("bill_no")
  /// THE ACCOUNTING DATE — the buying day this fish came from, not the day it
  /// was sold.
  ///
  /// Fish bought on the 16th is sold across the 17th and 18th, so a sale dated
  /// by when it happened would land in a day's profit that has none of the
  /// purchase behind it. Dating it by the purchase day instead means the Day
  /// Book for the 16th shows that catch's purchases, sales and expenses
  /// together, and the profit is the real one. Every ledger entry, statement,
  /// register and report reads this field and nothing else.
  date          DateTime @db.Date
  /// When the sale actually happened. Record only — deliberately read by no
  /// ledger, no report and no balance, so it can never move a figure. It exists
  /// because `date` above is now the purchase day, and the real date of the
  /// transaction would otherwise be lost. Null on rows entered before the two
  /// dates were separated, where `date` was both.
  saleDate      DateTime? @map("sale_date") @db.Date

  amount Decimal @db.Decimal(14, 2)

  // Market-only (recorded/displayed, not posted):
  totalBill  Decimal? @map("total_bill") @db.Decimal(14, 2) // gross incl. seller profit + expenses
  commission Decimal? @db.Decimal(14, 2) // 2% of totalBill, reference only
  place      String? // Market "Place"

  // Fish Mill-only:
  weight         Decimal? @db.Decimal(12, 3)
  netWeight      Decimal? @map("net_weight") @db.Decimal(12, 3)
  vehicleNo      String?  @map("vehicle_no")
  placeOfLoading String?  @map("place_of_loading")

  // Factory-only:
  returnNote String? @map("return_note")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  company     Company    @relation(fields: [companyId], references: [id])
  centre      Centre     @relation(fields: [centreId], references: [id])
  party       Party      @relation("SaleBuyer", fields: [partyId], references: [id])
  careOfParty Party?     @relation("SaleCareOf", fields: [careOfPartyId], references: [id])
  createdBy   User?      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?      @relation("SaleUpdatedBy", fields: [updatedById], references: [id])
  lines       SaleLine[]

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, type])
  @@map("sales")
}

// Line items for Fish Mill and Local sales.
// Fish Mill: box · variety(particular) · kgs(qtyKg) · rate/kg · count · total.
// Local:     particular · qty(qtyKg) · rate/kg · total.
model SaleLine {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  particular String
  box        Int? // Fish Mill only
  qtyKg      Decimal @map("qty_kg") @db.Decimal(12, 3)
  ratePerKg  Decimal @map("rate_per_kg") @db.Decimal(12, 2)
  count      Int? // Fish Mill only
  total      Decimal @db.Decimal(14, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_lines")
}

// ---------- Settlements (payments & receipts) ----------

enum SettlementKind {
  PAYMENT // we pay a supplier — DEBITs their ledger
  RECEIPT // a customer pays us — CREDITs their ledger
}

enum SettlementMode {
  CASH
  BANK
  UPI
  CHEQUE
}

/**
 * A movement of money against a party, recorded as its own voucher.
 * This is deliberately separate from Purchase and Sale. Settlement used to be
 * implied by `Purchase.paid` and `Sale.amountReceived`, which posted a hidden
 * offsetting ledger row sharing the voucher's own id — so a purchase and its
 * payment were one indivisible record that could not be dated apart, paid in
 * instalments, or corrected independently. A trade and its settlement are
 * different events on different dates and each gets its own voucher.
 * Settlements are party-level, not bill-level: a receipt reduces what the
 * party owes across the whole relationship rather than being allocated to one
 * invoice. That matches how the running outstanding is read off the statement.
 */
model Settlement {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  centreId    String         @map("centre_id")
  partyId     String         @map("party_id")
  kind        SettlementKind
  mode        SettlementMode @default(CASH)
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime       @db.Date
  /// Cheque number, UPI reference, slip number — free text.
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @map("updated_at")
  createdById String?        @map("created_by_id")
  updatedById String?        @map("updated_by_id")

  company   Company @relation(fields: [companyId], references: [id])
  centre    Centre  @relation(fields: [centreId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("SettlementUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId, centreId, date])
  @@index([companyId, centreId, partyId])
  @@map("settlements")
}

// ---------- Ledger ----------

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  PURCHASE
  SALE
  EXPENSE
  PAYMENT // money out — settles what we owe a supplier
  RECEIPT // money in — settles what a customer owes us
  COMMISSION // 2% agent commission earned on a Market sale
}

// One generic ledger table powers every party statement — no per-party-type
// ledger tables. Sign convention: positive = party owes us, negative = we owe
// the party. DEBIT increases the balance, CREDIT decreases it.
model LedgerEntry {
  id             String           @id @default(uuid())
  // Monotonic insertion order. `created_at` only has millisecond precision, so
  // entries written inside one transaction can tie — and a tie makes the
  // running-balance window function non-deterministic, which is what let
  // statements drift. (date, seq) is a total order, so a recompute always
  // produces the same chain. Not a primary key; the uuid `id` stays.
  seq            Int              @unique @default(autoincrement())
  companyId      String           @map("company_id")
  centreId       String           @map("centre_id")
  partyId        String           @map("party_id")
  type           LedgerEntryType
  sourceType     LedgerSourceType @map("source_type")
  sourceId       String           @map("source_id")
  amount         Decimal          @db.Decimal(14, 2)
  date           DateTime         @db.Date
  runningBalance Decimal          @map("running_balance") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])
  party   Party   @relation(fields: [partyId], references: [id])

  // Covers both the statement read (ordered by date, seq) and the recompute
  // window, which partitions on exactly this key.
  @@index([companyId, centreId, partyId, date, seq])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

// ---------- Attachments ----------

enum AttachmentLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

model Attachment {
  id         String               @id @default(uuid())
  companyId  String               @map("company_id")
  centreId   String               @map("centre_id")
  linkedType AttachmentLinkedType @map("linked_type")
  linkedId   String               @map("linked_id")
  storageKey String               @map("storage_key")
  uploadedAt DateTime             @default(now()) @map("uploaded_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@index([linkedType, linkedId])
  @@map("attachments")
}

// ---------- Review requests ----------

// Which voucher a review request points at. PAYMENT and RECEIPT are both rows
// in `settlements`; they are kept apart here because they live under different
// URLs and read as different vouchers to the people using them.
enum ReviewLinkedType {
  PURCHASE
  SALE
  EXPENSE
  DELIVERY_NOTE
  PAYMENT
  RECEIPT
}

enum ReviewStatus {
  OPEN
  RESOLVED
}

/**
 * An accountant asking an admin to correct a voucher.
 *
 * An accountant may enter a voucher but never edit one (see Role), so a typo
 * discovered after saving had no route back — the entry simply stayed wrong.
 * This is that route: the accountant raises a request naming what is wrong, and
 * it surfaces on the admin's dashboard under the company and centre the voucher
 * was entered in.
 *
 * The scope is copied from the voucher row itself, not from whatever scope the
 * requester happens to be sitting in, so a request always files against the
 * centre that owns the entry.
 *
 * Requests close by themselves: the next admin edit (or delete) of that voucher
 * marks every open request against it RESOLVED. Nothing here is deleted when a
 * voucher is — the request is the record that a correction was asked for, and
 * that outlives the row it was about.
 *
 * At most one request per voucher may be OPEN at a time; the create action
 * enforces that inside its transaction. Resolved ones accumulate, so the same
 * voucher can be queried about more than once over its life.
 */
model ReviewRequest {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  centreId      String           @map("centre_id")
  linkedType    ReviewLinkedType @map("linked_type")
  linkedId      String           @map("linked_id")
  status        ReviewStatus     @default(OPEN)
  /// What the accountant says is wrong. Required — a request with no reason
  /// gives the admin nothing to act on.
  reason        String
  requestedById String?          @map("requested_by_id")
  requestedAt   DateTime         @default(now()) @map("requested_at")
  resolvedById  String?          @map("resolved_by_id")
  resolvedAt    DateTime?        @map("resolved_at")

  company     Company @relation(fields: [companyId], references: [id])
  centre      Centre  @relation(fields: [centreId], references: [id])
  requestedBy User?   @relation("ReviewRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?   @relation("ReviewResolvedBy", fields: [resolvedById], references: [id])

  // The dashboard read: open requests for one company and centre, newest first.
  @@index([companyId, centreId, status, requestedAt])
  // The voucher read: does this voucher have an open request against it?
  @@index([linkedType, linkedId, status])
  @@map("review_requests")
}

// ---------- Day close & corrections ----------

// RETIRED. Day closing was removed from the application: an Admin may edit any
// voucher at any time, and only an Admin may edit at all. The table is kept so
// no historic rows are destroyed and the feature can be revived, but nothing
// writes to it and nothing reads it any more.
model DayClose {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  centreId  String   @map("centre_id")
  date      DateTime @db.Date
  closedAt  DateTime @default(now()) @map("closed_at")

  company Company @relation(fields: [companyId], references: [id])
  centre  Centre  @relation(fields: [centreId], references: [id])

  @@unique([companyId, centreId, date])
  @@map("day_closes")
}

enum ErrorFlagLinkedType {
  PURCHASE
  DELIVERY_NOTE
  SALE
  EXPENSE
}

// RETIRED alongside DayClose — nothing creates flags any more. Existing rows
// are still read: a flagged voucher stays visible, struck through, links to
// whatever replaced it, and is excluded from report totals.
model ErrorFlag {
  id                String              @id @default(uuid())
  linkedType        ErrorFlagLinkedType @map("linked_type")
  linkedId          String              @map("linked_id")
  flaggedAt         DateTime            @default(now()) @map("flagged_at")
  reason            String?
  correctingEntryId String?             @map("correcting_entry_id")

  @@unique([linkedType, linkedId])
  @@map("error_flags")
}
