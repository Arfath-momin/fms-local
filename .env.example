# Copy to .env and fill in. Never commit the result.
#
# LOCAL DEVELOPMENT (npm run dev) uses all three of the first block.
# DOCKER DEPLOYMENT (docker compose up) uses only the second block — compose
# derives DATABASE_URL from the postgres service and sets UPLOADS_DIR itself,
# so leaving dev values in place cannot misdirect the deployed app.

# --- local development -------------------------------------------------------

# Embedded Postgres started by `npm run db:dev`.
DATABASE_URL="postgresql://fms:fms@localhost:5502/fms"

# Where bill/receipt images are written. Relative paths resolve against the
# working directory.
UPLOADS_DIR="uploads"

# --- both --------------------------------------------------------------------

# Signs the session cookie. Use a different value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- docker deployment only --------------------------------------------------

# Postgres credentials for the container. The password has no default: compose
# refuses to start without it.
POSTGRES_USER="fms"
POSTGRES_PASSWORD=""
POSTGRES_DB="fms"

# Public hostname. Caddy requests a Let's Encrypt certificate for it, so DNS
# must already point at this server. Use `localhost` to test without TLS.
FMS_DOMAIN=""

# Container timezone. Affects log timestamps and Postgres now(). It does NOT
# change how the app decides "today" — see the timezone note in
# docs/DEPLOYMENT.md before going live.
TZ="Asia/Kolkata"
